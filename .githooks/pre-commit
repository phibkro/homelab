#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
# Validate the index in isolation; never format or stage operator files.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
command -v nix >/dev/null || { echo '[pre-commit] Nix is required; no checks were run.' >&2; exit 1; }
snapshot="$(mktemp -d "${TMPDIR:-/tmp}/homelab-staged.XXXXXXXX")"
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
# Git hooks may inherit an alternate index. Never propagate it to the fixture.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
cd "$snapshot"
git init --quiet
git add --all --force
printf '[pre-commit] checking exact staged snapshot (Nix + Pi static checks)…\n' >&2
nix develop --command bash scripts/check-nix.sh fast
nix develop --command just pi::check
printf '[pre-commit] staged snapshot passed; operator index and working files preserved.\n' >&2
