{
  admin off
  email {{ caddy_acme_email }}
  http_port {{ caddy_http_port }}
  https_port {{ caddy_https_port }}
{% if caddy_tls_mode == 'cloudflare' %}
  acme_ca https://acme-v02.api.letsencrypt.org/directory
{% endif %}
}

{% for domain in pi_deprecated_domains | default([]) %}
http://*.{{ domain }} {
  bind {{ pi_service_bind_address }}
  @legacySubdomain header_regexp Host ^([^.]+)\.{{ domain | regex_escape }}$
  redir @legacySubdomain https://{re.legacySubdomain.1}.{{ pi_domain }}{uri} 301
}

{% endfor %}
*.{{ pi_domain }} {
{% if gatus_public_enabled | default(false) %}
  bind {{ pi_service_bind_address }} {{ gatus_public_network_gateway }}
{% else %}
  bind {{ pi_service_bind_address }}
{% endif %}
{% if caddy_tls_mode == 'internal' %}
  tls internal
{% else %}
  tls {
    dns cloudflare {env.CF_API_TOKEN}
  }
{% endif %}

{% for route in pi_routes %}
  @{{ route.name }} {
    host {{ route.hostname }}
{% if route.reachability | default('internal') == 'internal' %}
    client_ip private_ranges 100.64.0.0/10
    not client_ip {{ gatus_public_network_subnet }}
{% endif %}
  }
  handle @{{ route.name }} {
{% if route.auth | default('none') == 'forward-auth' %}
{% if route.forward_auth_exempt_paths | length > 0 %}
    @{{ route.name }}AuthNeeded {
      not path {{ route.forward_auth_exempt_paths | join(' ') }}
    }
    forward_auth @{{ route.name }}AuthNeeded http://{{ route.forward_auth_upstream }} {
      uri /api/verify?rd={{ caddy_forward_auth_redirect_url }}
      copy_headers Remote-User Remote-Email Remote-Name Remote-Groups
    }
{% else %}
    forward_auth http://{{ route.forward_auth_upstream }} {
      uri /api/verify?rd={{ caddy_forward_auth_redirect_url }}
      copy_headers Remote-User Remote-Email Remote-Name Remote-Groups
    }
{% endif %}
{% endif %}
    reverse_proxy {{ route.scheme | default('http') }}://{{ route.upstream_address }}:{{ route.upstream_port }} {
{% if route.upstream_host_header is defined and route.upstream_host_header %}
      header_up Host {{ route.upstream_host_header }}
{% endif %}
{% if route.upstream_origin_header is defined and route.upstream_origin_header %}
      header_up Origin {{ route.upstream_origin_header }}
{% endif %}
    }
  }

{% endfor %}
  handle {
    respond 404
  }
}
