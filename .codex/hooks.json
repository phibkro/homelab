{
  "description": "Repository-local lifecycle checks shared with Claude Code.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/hooks/post-edit-nix.sh\"",
            "timeout": 120,
            "statusMessage": "Formatting and checking Nix edits"
          }
        ]
      }
    ]
  }
}
