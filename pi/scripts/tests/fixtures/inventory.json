{
  "site": {
    "domain": "home.example",
    "deprecatedDomains": ["nori.lan"],
    "entryPlaneHost": "pi"
  },
  "hosts": {
    "pi": {"lanIp": "192.168.1.225", "tailnetIp": "100.100.71.3"},
    "workstation": {
      "lanIp": "192.168.1.181",
      "tailnetIp": "100.81.5.122",
      "workloads": ["calibre-web", "jellyfin", "immich", "node-exporter", "nvidia-gpu-exporter"]
    },
    "aurora": {
      "lanIp": null,
      "tailnetIp": "100.101.67.111",
      "workloads": ["node-exporter"]
    }
  },
  "workloads": {
    "authelia": {
      "active": true,
      "endpoints": {
        "auth": {
          "port": 9091,
          "runsOn": "pi",
          "audience": "public",
          "monitor": {"path": "/api/health", "conditions": ["[STATUS] == 200"]}
        }
      }
    },
    "calibre-web": {
      "active": true,
      "endpoints": {
        "books": {
          "port": 8084,
          "runsOn": "workstation",
          "audience": "family",
          "forwardAuth": {"exemptPaths": ["/api/*"]},
          "monitor": {}
        }
      }
    },
    "jellyfin": {
      "active": true,
      "endpoints": {
        "media": {
          "port": 8096,
          "runsOn": "workstation",
          "audience": "family",
          "reachability": "internet",
          "monitor": {"path": "/health", "failureThreshold": 5}
        }
      }
    },
    "immich": {
      "active": true,
      "endpoints": {
        "photos": {
          "port": 2283,
          "runsOn": "workstation",
          "audience": "family",
          "oidc": {
            "clientName": "Immich",
            "redirectPath": "/auth/login",
            "authorizationPolicy": "one_factor",
            "tokenEndpointAuthMethod": "client_secret_post",
            "scopes": ["openid", "profile", "email", "groups"]
          },
          "monitor": {"path": "/api/server/ping", "interval": "30s"}
        }
      }
    },
    "disabled": {
      "active": false,
      "endpoints": {"must-not-route": {"port": 6553, "runsOn": "workstation"}}
    },
    "node-exporter": {
      "active": true,
      "hosts": ["workstation", "aurora"],
      "endpoints": {}
    },
    "nvidia-gpu-exporter": {
      "active": true,
      "hosts": ["workstation"],
      "endpoints": {}
    }
  }
}
