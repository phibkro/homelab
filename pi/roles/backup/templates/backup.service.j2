# homelab-pi-backup-role: managed
[Unit]
Description=Pi restic backup — {{ unit_job.name }} to Aurora
Wants=network-online.target
After=network-online.target tailscaled.service
OnFailure=notify@pi-restic-backup-{{ unit_job.name }}.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/pi-restic-backup-{{ unit_job.name }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
ReadWritePaths={{ pi_backup_state_dir }} {{ pi_backup_cache_dir }}
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
LockPersonality=true
SystemCallFilter=@system-service
TimeoutStartSec=12h
