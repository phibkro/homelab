[Unit]
Description=Beszel monitoring hub (Podman)
Requires=podman.service
Wants=network-online.target
After=network-online.target podman.service
RequiresMountsFor={{ beszel_data_dir }}

[Service]
Type=exec
ExecStart=/usr/bin/podman start --attach beszel
ExecStop=/usr/bin/podman stop --time 10 beszel
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
