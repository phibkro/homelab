data_dir: {{ vector_data_dir | tojson }}

api:
  enabled: true
  address: {{ vector_api_address | tojson }}

sources:
  journald:
    type: journald
    current_boot_only: false

transforms:
  relabel:
    type: remap
    inputs:
      - journald
    source: |
      .unit = ._SYSTEMD_UNIT
      .pid = ._PID
      .priority = .PRIORITY
      .timestamp = .timestamp
      msg = to_string(.message) ?? ""
      if starts_with(msg, "{") {
        parsed, err = parse_json(msg)
        if err == null { .parsed = parsed }
      }
      if !exists(.parsed) && contains(msg, "=") {
        parsed, err = parse_logfmt(msg)
        if err == null && length(parsed) > 1 { .parsed = parsed }
      }
      if exists(.parsed.level)  { .level = .parsed.level }
      if exists(.parsed.lvl)    { .level = .parsed.lvl }
      if exists(.parsed.source) { .source = .parsed.source }
      if exists(.parsed.caller) { .source = .parsed.caller }
      if exists(.parsed.error)  { .error = .parsed.error }
      if exists(.parsed.err)    { .error = .parsed.err }

sinks:
  victorialogs:
    type: elasticsearch
    inputs:
      - relabel
    endpoints:
      - {{ vector_victorialogs_endpoint | tojson }}
    mode: bulk
    api_version: {{ vector_victorialogs_api_version | tojson }}
    healthcheck:
      enabled: false
    query:
      _msg_field: message
      _time_field: timestamp
      _stream_fields: host,unit
