[Unit]
Description=Beszel monitoring agent (Podman)
Requires=podman.service
Wants=network-online.target
After=network-online.target podman.service
RequiresMountsFor={{ beszel_agent_config_dir }} {{ beszel_agent_data_dir }}

[Service]
Type=exec
ExecStart=/usr/bin/podman start --attach {{ beszel_agent_container_name }}
ExecStop=/usr/bin/podman stop --time 10 {{ beszel_agent_container_name }}
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
