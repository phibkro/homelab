diff --git a/src/services/unifi/manifest.nix b/src/services/unifi/manifest.nix
new file mode 100644
index 0000000..ac29a3c
--- /dev/null
+++ b/src/services/unifi/manifest.nix
@@ -0,0 +1,39 @@
+{
+  active = true;
+  kind = "service";
+  hostRoles = [ "workhorse" ];
+  placement = {
+    strategy = "first-unique";
+    selectors = [ { host = "workstation"; } ];
+    cardinality = {
+      min = 1;
+      max = 1;
+    };
+  };
+  runtimeModule = ./nixos.nix;
+  tags = [
+    "network-appliance"
+    "stateful"
+  ];
+  recovery = {
+    model = "application-export";
+    backupJob = "unifi";
+  };
+
+  # No endpoint: the controller UI stays on the private tailnet listener and
+  # does not create a Caddy route, DNS record, or external authentication client.
+  # Reserve every controller port in inventory to catch local collisions.
+  listeners = {
+    inform.port = 8080;
+    ui.port = 8443;
+    portal-http.port = 8880;
+    portal-https.port = 8843;
+    portal-https-proxy.port = 8444;
+    throughput.port = 6789;
+    database.port = 27117;
+    stun.port = 3478;
+    discovery.port = 10001;
+    redirector.port = 8881;
+    redirector-wired.port = 8882;
+  };
+}
diff --git a/src/services/unifi/nixos.nix b/src/services/unifi/nixos.nix
new file mode 100644
index 0000000..43fa775
--- /dev/null
+++ b/src/services/unifi/nixos.nix
@@ -0,0 +1,31 @@
+{ config, ... }:
+
+let
+  listeners = config.nori.inventory.workloads.unifi.listeners;
+in
+{
+  services.unifi = {
+    enable = true;
+    # The NixOS module opens ports globally; keep all firewall policy local.
+    openFirewall = false;
+  };
+
+  networking.firewall.interfaces.tailscale0.allowedTCPPorts = [ listeners.ui.port ];
+
+  # nixpkgs' unit already applies strict systemd hardening and scopes its
+  # StateDirectory to /var/lib/unifi. Register it with the local FS policy too.
+  nori.harden.unifi = { };
+
+  # Preserve UniFi state and native application exports, but do not hot-copy
+  # live MongoDB files: filesystem snapshots are not a consistent DB backup.
+  # UniFi documents software autobackups at {data.dir}/backup/autobackup
+  # (https://help.ui.com/hc/en-us/articles/205202580-Explaining-the-UniFi-system-properties-File).
+  # The NixOS module's removed dataDir notice maps this deployment's data
+  # directory to /var/lib/unifi/data.
+  # Enable/schedule autobackups in the controller UI.
+  nori.backups.unifi = {
+    include = [ "/var/lib/unifi" ];
+    exclude = [ "/var/lib/unifi/data/db" ];
+    tier = "service";
+  };
+}
