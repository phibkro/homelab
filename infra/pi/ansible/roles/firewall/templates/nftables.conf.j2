#!/usr/sbin/nft -f

# Replace only the appliance-owned table. Flushing the global ruleset removes
# Podman's netavark NAT/forwarding tables and strands every running container.
delete table inet appliance_filter

table inet appliance_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state established,related accept
    ct state invalid drop

    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
    udp dport 41641 accept

    ip saddr {{ pi_lan_cidr }} tcp dport 22 accept
    ip saddr {{ pi_lan_cidr }} udp dport {{ pi_dns_port }} accept
    ip saddr {{ pi_lan_cidr }} tcp dport {
      {{ pi_dns_port }}, {{ pi_admin_port }}{% if caddy_enabled %}, {{ caddy_http_port }}, {{ caddy_https_port }}{% endif %}
    } accept

    iifname "{{ pi_tailnet_interface }}" tcp dport 22 accept
    iifname "{{ pi_tailnet_interface }}" udp dport {{ pi_dns_port }} accept
    iifname "{{ pi_tailnet_interface }}" tcp dport {{ pi_dns_port }} accept
{% if pi_tailnet_tcp_ports | default([]) | length > 0 %}
    iifname "{{ pi_tailnet_interface }}" tcp dport { {{ pi_tailnet_tcp_ports | map('int') | join(', ') }} } accept
{% endif %}
{% if caddy_enabled %}
    iifname "{{ pi_tailnet_interface }}" tcp dport { {{ caddy_http_port }}, {{ caddy_https_port }} } accept
{% endif %}
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
