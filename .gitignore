# Nix
result
result-*
.direnv/
node_modules/
.alchemy/

# Python helpers (including repo-managed agent skills)
__pycache__/
*.py[cod]

# JUCI execution artifacts may expose topology or carry live policy grants
juci-audit*.json
juci-grant*.json

# Local flake state (generated, not source of truth)
flake.lock.local

# Inventory output must never land in the repo — it contains system info
# (process lists, container env, etc.) that may include secrets.
inventory-*/
inventory-*.tar.gz

# Editor
.vscode/
.idea/
*.swp
*.swo

# Per-project Claude Code state — local-only (settings, scheduled tasks,
# session caches). Skills are project artifacts and ARE committed; the
# negation lets them through.
.claude/*
!.claude/settings.json
!.claude/skills/

# Nested standalone project — pagu has its own git repo; homelab must
# not track it. (Local dev checkout; published separately.)
/pagu/

# OS
.DS_Store
